<Project>
	<PropertyGroup>
		<!-- Public Framework 3.1.2 still bundles DRM; use the clean source by default. -->
		<UseSphere10FrameworkSource Condition="'$(UseSphere10FrameworkSource)' == ''">true</UseSphere10FrameworkSource>
		<Sphere10FrameworkRoot Condition="'$(Sphere10FrameworkRoot)' == ''">$(MSBuildThisFileDirectory)../Framework</Sphere10FrameworkRoot>

		<!-- The current projection requires renderer APIs newer than the public 3.1.3 package. -->
		<UseSphere10VisualRendererSource Condition="'$(UseSphere10VisualRendererSource)' == '' And '$(Sphere10VisualRendererVersion)' != ''">false</UseSphere10VisualRendererSource>
		<UseSphere10VisualRendererSource Condition="'$(UseSphere10VisualRendererSource)' == ''">true</UseSphere10VisualRendererSource>
		<Sphere10VisualRendererRoot Condition="'$(Sphere10VisualRendererRoot)' == ''">$(MSBuildThisFileDirectory)../Components/Sphere10.VisualRenderer</Sphere10VisualRendererRoot>

		<!-- Package mode requires an explicitly supplied, separately verified clean version. -->
	</PropertyGroup>
  <!-- The vendored Notion.Client keeps its upstream version and package identity. -->
  <PropertyGroup>
    <IsLocalNotionProduct Condition="'$(MSBuildProjectName)' == 'LocalNotion.CLI' Or '$(MSBuildProjectName)' == 'LocalNotion.Core'">true</IsLocalNotionProduct>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLocalNotionProduct)' == 'true'">
    <!-- Capture before Version.props defaults an omitted BuildNumber to 0. -->
    <_LocalNotionExplicitBuildNumber>$(BuildNumber)</_LocalNotionExplicitBuildNumber>
    <_LocalNotionBuildCounterFile>$(MSBuildThisFileDirectory)LOCAL-BUILD-NUMBER</_LocalNotionBuildCounterFile>
  </PropertyGroup>

  <Import Project="Version.props" Condition="'$(IsLocalNotionProduct)' == 'true'" />

  <PropertyGroup Condition="'$(IsLocalNotionProduct)' == 'true'">
    <Version>$(ReleaseVersion)</Version>
    <PackageVersion>$(ReleaseVersion)</PackageVersion>
    <_LocalNotionVersionPrefix>$([System.Text.RegularExpressions.Regex]::Match('$(ReleaseVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</_LocalNotionVersionPrefix>
    <AssemblyVersion>$(_LocalNotionVersionPrefix).$(BuildNumber)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(FileVersion)</InformationalVersion>
    <!-- Keep git SHA out of CLI version output; commit is recorded separately in release metadata. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<!-- Attribution/custom attributes stay in AssemblyInfo.cs; Directory.Build.targets generates versions only. -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<AssemblyName>localnotion</AssemblyName>
		<ApplicationIcon>../assets/branding/local-notion.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <Sphere10Library Include="Sphere10.Framework" />
	  <Sphere10Library Include="Sphere10.Framework.Application" />
	  <Sphere10Library Include="Sphere10.Framework.Data" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LocalNotion.Core\LocalNotion.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\LICENSE" Link="LICENSE" TargetPath="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<None Include="..\COPYRIGHT" Link="COPYRIGHT" TargetPath="COPYRIGHT" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<None Include="..\COPYING.EXCEPTION" Link="COPYING.EXCEPTION" TargetPath="COPYING.EXCEPTION" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

</Project>

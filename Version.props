<Project>
  <PropertyGroup>
    <!-- The release version is shared by the CLI and Core; CI may override it explicitly. -->
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">1.6.1</ReleaseVersion>
    <!-- CI supplies github.run_number. Local CLI builds allocate the next number from LOCAL-BUILD-NUMBER when this is omitted. -->
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
  </PropertyGroup>
</Project>
